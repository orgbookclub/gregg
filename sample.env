DISCORD_TOKEN=

HOME_GUILD_ID=
CLIENT_ID=
CLIENT_SECRET=
API_URL=

SENTRY_DSN=
MONGODB_URI=

WH_URL=

# AI / Foundry — set AI_ENABLED=true to activate the @gregg agent.
AI_ENABLED=false
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AI_MODEL_GENERAL=gpt-5.4-mini

# AI optional knobs.
AI_BETA_ROLE_ID=
AI_DEV_BYPASS=false
AI_LOG_RAW=false
AI_SESSION_IDLE_MINUTES=30
AI_SESSION_MAX_PROMPT_TOKENS=50000
AI_SESSION_MAX_COMPLETION_TOKENS=20000

# Per-turn and per-(guild,user,rolling 24h) token budgets. Independent
# from the per-session caps above; all three flag together when
# crossed. Counts promptTokens + completionTokens (reasoning excluded).
# Set AI_BUDGETS_ENABLED=false to disable enforcement entirely. Members
# with AI_BUDGET_BYPASS_ROLE_ID skip both checks even when enabled.
AI_BUDGETS_ENABLED=true
AI_TURN_MAX_TOKENS=10000
AI_DAILY_TOKEN_BUDGET=100000
AI_BUDGET_BYPASS_ROLE_ID=

# OWS MCP endpoint. Defaults to ${API_URL}/mcp when unset.
OWS_MCP_URL=