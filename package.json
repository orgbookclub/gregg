{
  "name": "gregg",
  "author": "ravsodhi",
  "version": "2.3.0",
  "description": "Discord Bot",
  "main": "./dist/index.js",
  "private": true,
  "license": "GPL-3.0-or-later",
  "keywords": [
    "discordjs",
    "discord",
    "bot",
    "discord-bot",
    "organized-book-club"
  ],
  "repository": "https://github.com/orgbookclub/gregg",
  "bugs": {
    "url": "https://github.com/orgbookclub/gregg/issues"
  },
  "homepage": "https://gregg-bot.azurewebsites.net/",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "tsc",
    "postinstall": "prisma generate",
    "lint": "eslint src --max-warnings 0 && prettier src --check",
    "lint:fix": "eslint src --max-warnings 0 --fix && prettier src --write",
    "start": "node ./dist/index.js",
    "start:dev": "tsc && node -r dotenv/config ./dist/index.js"
  },
  "dependencies": {
    "@organizedbookclub/ows-client": "^2.1.1",
    "@prisma/client": "^6.4.1",
    "@sentry/node": "^10.53.1",
    "axios": "^1.15.2",
    "cron": "^4.3.0",
    "discord.js": "^14.26.4",
    "express": "^4.21.2",
    "fast-glob": "^3.3.2",
    "pino": "^9.2.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.39.2",
    "@types/express": "^4.17.17",
    "@types/node": "^24.12.4",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.24.1",
    "csv": "^6.3.8",
    "dotenv": "^16.4.5",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.3",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "prettier": "^3.5.2",
    "prisma": "^6.4.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
